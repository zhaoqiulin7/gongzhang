{
  "name": "gongzhang",
  "version": "2.11.0",
  "private": true,
  "description": "工账 —— 装修施工管理与记账（网页版 PWA + 安卓 App 双形态）",
  "scripts": {
    "build": "node build.js",
    "build:www": "node build.js --www",
    "build:single": "node build.js --single",
    "verify": "node scripts/verify.js",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "apk": "bash scripts/build-android.sh",
    "apk:release": "bash scripts/build-android-release.sh",
    "aab": "bash scripts/build-android-release.sh bundle",
    "stress": "node scripts/gen-stress-data.js 5000 200 out/压测备份.json",
    "emu": "powershell -ExecutionPolicy Bypass -File scripts/demo-emulator.ps1",
    "emu:avd": "powershell -ExecutionPolicy Bypass -File scripts/demo-emulator.ps1 -UseAvd",
    "emu:fast": "powershell -ExecutionPolicy Bypass -File scripts/demo-emulator.ps1 -SkipBuild"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
